{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/backend/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "testEmailQueue.ts"],
  "exclude": ["node_modules", "dist"]
}
